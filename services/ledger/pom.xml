<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.psp</groupId>
    <artifactId>kafka-psp-pipeline</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>ledger</artifactId>
  <packaging>jar</packaging>

  <name>ledger</name>
  <description>
    ledger (M7): exactly-once semantics. Consumes payments.payment-status-changed.v1 with a
    transactional producer (transactional.id, sendOffsetsToTransaction, read_committed),
    maintains per-merchant balances in its own Postgres database, and publishes
    ledger.ledger-entry-recorded.v1. Two DISTINCT mechanisms, never conflated: Kafka EOS covers
    consume-offset-commit + produce (both in Kafka); the Postgres balance write is outside it and
    is made idempotent the M5 way, keyed on the inbound envelope eventId. Hexagonal layout
    enforced by an ArchUnit test; same conventions as psp-connector (M4/M5).
  </description>

  <dependencies>
    <!-- Internal libs -->
    <dependency>
      <groupId>com.example.psp</groupId>
      <artifactId>common-events</artifactId>
    </dependency>
    <!-- M18 phase 2: Kafka-aware HealthIndicators (kafkaListeners / kafkaStreams) so the
         Kubernetes readiness probe reflects the listener containers, not just the servlet.
         Inert unless psp.health.kafka.enabled=true, which only the k8s ConfigMap sets. -->
    <dependency>
      <groupId>com.example.psp</groupId>
      <artifactId>common-health</artifactId>
    </dependency>
    <!-- M11: RFC 7807 ProblemDetail error handling (GlobalExceptionHandler) for the new
         GET /api/refunds/{refundId} endpoint - same convention payment-api already uses. Without
         this, a NoSuchElementException (an unknown refundId) falls through to Spring Boot's
         generic 500 error page instead of a proper 404. The M8 DLQ replay endpoint this service's
         web dependency was added for will use the same handler. -->
    <dependency>
      <groupId>com.example.psp</groupId>
      <artifactId>common-web</artifactId>
    </dependency>

    <!-- M16/ADR-0009: Eureka client - compose profile only, same convention as every other
         service (see payment-api/pom.xml's identical comment). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>

    <!-- Web + actuator: no business REST endpoints through M7 (ADR-0004 - inter-service traffic
         is Kafka-only), but actuator health/info/metrics needs a web server to expose HTTP; M11
         adds GET /api/refunds/{refundId}, and the M8 DLQ replay endpoint
         (payments.payment-status-changed.v1.ledger.dlq) will live here too. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- M15: Micrometer Tracing bridged to OpenTelemetry, exporting to Tempo over OTLP - see
         payment-api/pom.xml's comment for why no <version> is needed. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <!-- Real Postgres persistence (ADR-0005: ledger owns its own database, `ledger`) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway >= 10 split DB-specific support out of flyway-core -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Kafka: transactional producer + read_committed consumer (this module's headline) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- M9 Phase 2: payments.payment-status-changed.v1 (inbound) and
         ledger.ledger-entry-recorded.v1 (outbound) are now Avro + Schema Registry. -->
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
    </dependency>

    <!-- Lombok + MapStruct (annotation processor order fixed in the parent) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-memory DB for the plain context-load test - the real Postgres migration is exercised
         for real against the live compose stack, not here (same pattern as psp-connector). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- M19 "Plus": Testcontainers for LedgerEosIT. Versions come from the testcontainers-bom in
         the parent POM. A real broker is not optional here: the transactional producer
         (config.KafkaProducerConfig) needs a real transaction coordinator and the assertion side
         needs a real read_committed consumer, neither of which a mock can fake. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ledger</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
