<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.psp</groupId>
    <artifactId>kafka-psp-pipeline</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>payment-api</artifactId>
  <packaging>jar</packaging>

  <name>payment-api</name>
  <description>
    payment-api (M3): POST /api/payments -&gt; validate -&gt; Postgres insert -&gt; publish
    payments.payment-requested.v1. Hexagonal layout enforced by an ArchUnit test; MapStruct at
    every boundary (web DTO, JPA entity, Kafka event).
  </description>

  <dependencies>
    <!-- Internal libs -->
    <dependency>
      <groupId>com.example.psp</groupId>
      <artifactId>common-events</artifactId>
    </dependency>
    <!-- M18 phase 2: Kafka-aware HealthIndicators (kafkaListeners / kafkaStreams) so the
         Kubernetes readiness probe reflects the listener containers, not just the servlet.
         Inert unless psp.health.kafka.enabled=true, which only the k8s ConfigMap sets. -->
    <dependency>
      <groupId>com.example.psp</groupId>
      <artifactId>common-health</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example.psp</groupId>
      <artifactId>common-web</artifactId>
    </dependency>

    <!-- M16/ADR-0009: Eureka client - compose profile only. eureka.client.enabled=false by
         default (application.yml) so `mvn verify`'s context-load test needs no running registry;
         application-docker-compose.yml flips it on so api-gateway can resolve lb://payment-api. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>

    <!-- Web + actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- M17: springdoc serves /v3/api-docs so ui/'s `pnpm gen:api` (openapi-typescript) can
         generate request/response types from the real controllers instead of hand-written
         copies - the codegen step PLAN.md's M17 stack always called for. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>2.8.5</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bean validation on the CreatePaymentRequest record (M3) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- M15: Micrometer Tracing bridged to OpenTelemetry, exporting to Tempo over OTLP. No
         <version> on either - both are managed transitively by spring-boot-dependencies' imported
         micrometer-tracing-bom/opentelemetry-bom (ADR-0007's "versions live in the parent POM
         only" rule holds even though these two aren't declared in THIS repo's own
         dependencyManagement - they're already pinned one level up, by the Spring Boot BOM). Once
         this + actuator are both on the classpath, Boot's tracing autoconfiguration activates:
         every HTTP request gets a span (this service's root span, since payment-api is where a
         payment's trace begins), and every hand-built KafkaTemplate/listener-container-factory
         below is wired to participate in it once .setObservationEnabled(true) is called on it
         explicitly (see infra/compose/README.md's M15 section for why "explicitly" is load-
         bearing here). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <!-- Real Postgres persistence (M3, ADR-0005): JPA + Flyway-owned schema -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway >= 10 split DB-specific support out of flyway-core -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Real Kafka producer (M3) -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- M9 Phase 1: payment-api never sends to Kafka (M6 outbox), but it DOES now Avro-encode
         the payments.payment-requested.v1 outbox payload against Schema Registry directly - see
         adapters.out.outbox.OutboxPaymentEventPublisher and the README M9 section. -->
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
    </dependency>

    <!-- Lombok + MapStruct (annotation processor order fixed in the parent) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-memory DB for the plain context-load test (PaymentApiApplicationTests) - the real
         Postgres migration is exercised for real against the live compose stack, not here. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- M19 "Plus": Testcontainers for OutboxAtomicityIT. Postgres ONLY - no org.testcontainers:
         kafka here on purpose: the outbox row is relayed to Kafka by Debezium in production, so
         no Kafka broker takes part in the behaviour this IT asserts (see the IT's javadoc). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>payment-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
