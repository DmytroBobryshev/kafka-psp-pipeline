# infra/compose/.env.example
#
# Template for infra/compose/.env. In this learning repo .env is committed with throwaway
# laptop-only defaults (see the comment at the top of .env), so this file exists mainly to show
# the pattern you'd follow in a real environment: copy this to .env, fill in real secrets, and
# add infra/compose/.env to .gitignore instead of committing it.
#
#   cp .env.example .env   # then edit the *_PASSWORD values below

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
KAFKA_IMAGE=confluentinc/cp-kafka
KAFKA_VERSION=7.7.1
SCHEMA_REGISTRY_VERSION=7.7.1
AKHQ_VERSION=0.24.0
POSTGRES_VERSION=16-alpine
MONGO_VERSION=7.0
KAFKA_EXPORTER_VERSION=v1.7.0
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.1.4
DEBEZIUM_CONNECT_VERSION=2.7.3.Final
# M15: single-binary Tempo (see infra/compose/README.md's M15 section for why Tempo over Jaeger).
TEMPO_VERSION=2.6.1
# M16 - Redis (api-gateway's RequestRateLimiter).
REDIS_VERSION=7.4-alpine

# ---------------------------------------------------------------------------
# KRaft cluster identity - generate your own with:
#   python3 -c "import base64,uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# ---------------------------------------------------------------------------
CLUSTER_ID=CHANGE_ME_22_CHAR_BASE64_UUID

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
KAFKA1_EXTERNAL_PORT=29092
KAFKA2_EXTERNAL_PORT=29093
KAFKA3_EXTERNAL_PORT=29094

SCHEMA_REGISTRY_PORT=8081
AKHQ_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_EXPORTER_PORT=9308
KAFKA_CONNECT_PORT=8083
# M15: OTLP/HTTP - what the six Spring services (host clients, like every other port in this
# section) push spans to. QUERY_PORT is Tempo's own API - what Grafana's datasource reads.
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_QUERY_PORT=3200

# M16 - discovery-server (the one Spring service that runs as a container - see its own service
# block in docker-compose.yml); api-gateway (8000) runs on the host like the six services, so it
# has no entry in this container-ports section.
DISCOVERY_SERVER_PORT=8761
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# PostgreSQL secrets - CHANGE THESE
# ---------------------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

PAYMENT_API_DB=payment_api
PAYMENT_API_DB_USER=payment_api
PAYMENT_API_DB_PASSWORD=CHANGE_ME

LEDGER_DB=ledger
LEDGER_DB_USER=ledger
LEDGER_DB_PASSWORD=CHANGE_ME

PSP_CONNECTOR_DB=psp_connector
PSP_CONNECTOR_DB_USER=psp_connector
PSP_CONNECTOR_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# MongoDB secrets - CHANGE THESE
# ---------------------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME

WEBHOOK_NOTIFIER_DB=webhook_notifier
WEBHOOK_NOTIFIER_DB_USER=webhook_notifier
WEBHOOK_NOTIFIER_DB_PASSWORD=CHANGE_ME

ANALYTICS_DB=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=CHANGE_ME

AUDIT_TRAIL_DB=audit_trail
AUDIT_TRAIL_DB_USER=audit_trail
AUDIT_TRAIL_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Grafana secrets - CHANGE THESE
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# M14 - Kafka security: SASL/SCRAM-SHA-512 credentials, one principal per client - CHANGE THESE
#
# One principal per client is the whole point: ACLs can only distinguish callers that have
# distinct identities. See infra/compose/README.md's "M14 - Security" section for the listener
# map, the full ACL matrix, and the rollback procedure.
#
# Avoid " \ $ and whitespace in these passwords - they are embedded in JAAS strings
# (sasl.jaas.config=... password="X";) and interpolated by docker compose.
#
# KAFKA_BROKER_* is a SASL/PLAIN principal read from the broker's own config file (inter-broker
# replication + the KRaft controller quorum). It cannot be SCRAM: SCRAM credentials live in the
# cluster metadata log, which does not exist yet at the moment a broker needs to authenticate to
# the quorum. Both it and KAFKA_ADMIN_USER are in super.users.
# ---------------------------------------------------------------------------
KAFKA_BROKER_USER=broker
KAFKA_BROKER_PASSWORD=CHANGE_ME

KAFKA_ADMIN_USER=admin
KAFKA_ADMIN_PASSWORD=CHANGE_ME

# Per-Spring-service principals. The USERNAME is not a secret and is committed in each service's
# application-docker-compose.yml; only these passwords are secret.
PAYMENT_API_KAFKA_PASSWORD=CHANGE_ME
PSP_CONNECTOR_KAFKA_PASSWORD=CHANGE_ME
LEDGER_KAFKA_PASSWORD=CHANGE_ME
WEBHOOK_NOTIFIER_KAFKA_PASSWORD=CHANGE_ME
ANALYTICS_KAFKA_PASSWORD=CHANGE_ME
REALTIME_GATEWAY_KAFKA_PASSWORD=CHANGE_ME

# Per-infrastructure-client principals.
CONNECT_KAFKA_PASSWORD=CHANGE_ME
SCHEMA_REGISTRY_KAFKA_PASSWORD=CHANGE_ME
AKHQ_KAFKA_PASSWORD=CHANGE_ME
KAFKA_EXPORTER_KAFKA_PASSWORD=CHANGE_ME
