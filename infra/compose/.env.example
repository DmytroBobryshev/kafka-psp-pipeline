# infra/compose/.env.example
#
# Template for infra/compose/.env. In this learning repo .env is committed with throwaway
# laptop-only defaults (see the comment at the top of .env), so this file exists mainly to show
# the pattern you'd follow in a real environment: copy this to .env, fill in real secrets, and
# add infra/compose/.env to .gitignore instead of committing it.
#
#   cp .env.example .env   # then edit the *_PASSWORD values below

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
KAFKA_IMAGE=confluentinc/cp-kafka
KAFKA_VERSION=7.7.1
SCHEMA_REGISTRY_VERSION=7.7.1
AKHQ_VERSION=0.24.0
POSTGRES_VERSION=16-alpine
MONGO_VERSION=7.0
KAFKA_EXPORTER_VERSION=v1.7.0
PROMETHEUS_VERSION=v2.54.1
GRAFANA_VERSION=11.1.4

# ---------------------------------------------------------------------------
# KRaft cluster identity - generate your own with:
#   python3 -c "import base64,uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# ---------------------------------------------------------------------------
CLUSTER_ID=CHANGE_ME_22_CHAR_BASE64_UUID

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
KAFKA1_EXTERNAL_PORT=29092
KAFKA2_EXTERNAL_PORT=29093
KAFKA3_EXTERNAL_PORT=29094

SCHEMA_REGISTRY_PORT=8081
AKHQ_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KAFKA_EXPORTER_PORT=9308

# ---------------------------------------------------------------------------
# PostgreSQL secrets - CHANGE THESE
# ---------------------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

PAYMENT_API_DB=payment_api
PAYMENT_API_DB_USER=payment_api
PAYMENT_API_DB_PASSWORD=CHANGE_ME

LEDGER_DB=ledger
LEDGER_DB_USER=ledger
LEDGER_DB_PASSWORD=CHANGE_ME

PSP_CONNECTOR_DB=psp_connector
PSP_CONNECTOR_DB_USER=psp_connector
PSP_CONNECTOR_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# MongoDB secrets - CHANGE THESE
# ---------------------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME

WEBHOOK_NOTIFIER_DB=webhook_notifier
WEBHOOK_NOTIFIER_DB_USER=webhook_notifier
WEBHOOK_NOTIFIER_DB_PASSWORD=CHANGE_ME

ANALYTICS_DB=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=CHANGE_ME

AUDIT_TRAIL_DB=audit_trail
AUDIT_TRAIL_DB_USER=audit_trail
AUDIT_TRAIL_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Grafana secrets - CHANGE THESE
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
