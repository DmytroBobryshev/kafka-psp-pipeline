{
  "title": "Kafka Cluster Overview (M2)",
  "uid": "kafka-m2-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["kafka", "m2"],
  "panels": [
    {
      "id": 1,
      "title": "Brokers online",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kafka_brokers",
          "legendFormat": "brokers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Partition count per topic",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "kafka_topic_partitions",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Partitions currently under-replicated (ISR < replicas)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "count(kafka_topic_partition_in_sync_replica < kafka_topic_partition_replicas)",
          "legendFormat": "under-replicated",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "In-sync replicas per partition (watch this during the broker-kill drill)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "kafka_topic_partition_in_sync_replica",
          "legendFormat": "{{topic}}-{{partition}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "max": 3 },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Partition leader by broker id",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "kafka_topic_partition_leader",
          "legendFormat": "{{topic}}-{{partition}}",
          "refId": "A"
        }
      ]
    }
  ]
}
