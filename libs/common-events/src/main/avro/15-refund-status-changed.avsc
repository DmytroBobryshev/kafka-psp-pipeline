{
  "type": "record",
  "name": "RefundStatusChanged",
  "namespace": "com.example.psp.common.events.avro",
  "doc": "Avro form of refunds.refund-status-changed.v1 - the refund-path mirror of payments.payment-status-changed.v1's PENDING/IPN_RECEIVED/VERIFIED trail (03-payment-status-changed.avsc), scoped down to those non-terminal saga stages PLUS one merchant-facing verdict this service reaches on its own: EXPIRED. Produced by TWO different sources, same split as payments.payment-status-changed.v1's own EXPIRED case - psp-connector's ExecuteRefundUseCase (adapters.out.kafka.KafkaRefundStatusPublisher) publishes PENDING/IPN_RECEIVED/VERIFIED as the provider saga actually progresses; payment-api's own refund-expiration sweep (application.ExpireRefundsUseCase) publishes EXPIRED for a refund that has sat past its merchant's refundExpirationSeconds window with no terminal refund_status_history row yet - history-only, same as payments.payment-status-changed.v1's EXPIRED case never overwriting Refund's own REQUESTED-only aggregate state (domain.model.Refund). The refund saga's PROVIDER-reported terminal outcome still travels on refunds.refund-completed.v1/refunds.refund-failed.v1 (09/10) unchanged and unconditionally - a later COMPLETED/FAILED still lands in the history trail even after an EXPIRED row, since the provider's verdict is authoritative and this schema still carries no declineReason. Keyed by merchantId (ADR-0003, same reasoning as payment-status-changed: every refund-saga event for one merchant must land on one partition, in order). Consumed by payment-api's refund_status_history projection AND (M24) by webhook-notifier's own planner, which plans a delivery only for the EXPIRED case. Registered under Schema Registry subject 'refunds.refund-status-changed.v1-value' (TopicNameStrategy, ADR-0001), BACKWARD compatibility.",
  "fields": [
    {
      "name": "envelope",
      "type": "com.example.psp.common.events.avro.EventEnvelope",
      "doc": "envelope.aggregateId = refundId."
    },
    {
      "name": "refundId",
      "type": "string",
      "doc": "UUID string form - the saga's correlation id, same value on every refunds.*.v1 event for this refund."
    },
    {
      "name": "paymentId",
      "type": "string",
      "doc": "The payment being refunded (UUID string form), carried through for the history endpoint."
    },
    {
      "name": "merchantId",
      "type": "string",
      "doc": "The owning merchant; IS the record key (ADR-0003)."
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "Generates java.math.BigDecimal (enableDecimalLogicalType=true)."
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO-4217 three-letter currency code."
    },
    {
      "name": "status",
      "type": "string",
      "doc": "'PENDING' (accepted for processing, before the provider call) -> 'IPN_RECEIVED' (provider responded) -> 'VERIFIED' (the attempt is durably recorded, genuinely new work), or (M24) 'EXPIRED' - payment-api's own refund-expiration sweep's verdict for a refund that sat past its merchant's window with no terminal history row yet (application.ExpireRefundsUseCase), NOT a provider-reported outcome. COMPLETED/FAILED are still refunds.refund-completed.v1/refunds.refund-failed.v1's job, unchanged, and still authoritative over EXPIRED if they arrive later."
    },
    {
      "name": "providerReference",
      "type": "string",
      "doc": "The (simulated) provider's own reference for this refund attempt (UUID string form) - '' for PENDING (no provider call yet), populated for IPN_RECEIVED/VERIFIED."
    }
  ]
}
