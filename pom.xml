<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.psp</groupId>
  <artifactId>kafka-psp-pipeline</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Kafka PSP Pipeline</name>
  <description>
    Mini PSP (payment service provider) event pipeline built to reach an intermediate Kafka
    level: Java/Spring Boot microservices, hexagonal architecture, MapStruct + Lombok,
    monorepo/Maven multi-module. See docs/PLAN.md and docs/adr/.
  </description>

  <properties>
    <!-- Language level -->
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Centralized versions (ADR-0007: child POMs declare dependencies WITHOUT versions) -->
    <spring-boot.version>3.5.3</spring-boot.version>
    <!-- M16: Spring Cloud 2025.0.x (Northfields) is the release train compatible with Spring Boot
         3.5.x (spring.io/projects/spring-cloud's compatibility matrix) - discovery-server (Eureka
         server) and api-gateway (Spring Cloud Gateway, Netflix Eureka client, LoadBalancer,
         Resilience4j Circuitbreaker) all come from this one BOM, imported below the same way the
         Spring Boot BOM already is. -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <lombok.version>1.18.38</lombok.version>
    <mapstruct.version>1.5.5.Final</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <archunit.version>1.3.0</archunit.version>
    <!-- M9 Phase 1: Avro + Schema Registry for payments.payment-requested.v1 only. avro.version
         tracks Confluent Platform 7.7.x's bundled Avro release; confluent.version is pinned to
         the SAME 7.7.1 as infra/compose/.env's SCHEMA_REGISTRY_VERSION so the client library and
         the running registry are the exact same Confluent release. -->
    <avro.version>1.11.3</avro.version>
    <confluent.version>7.7.1</confluent.version>

    <!-- M19 "Plus": Testcontainers. 1.20.6 is the last 1.20.x line; org.testcontainers.kafka.
         KafkaContainer (the KRaft-mode apache/kafka wrapper that replaced the ZooKeeper-era
         org.testcontainers.containers.KafkaContainer) landed in 1.20.1, so this line has it.
         Every module gets its versions from the testcontainers-bom imported below - child POMs
         declare org.testcontainers:{kafka,postgresql,mongodb,junit-jupiter} WITHOUT a <version>,
         exactly like every other dependency in this build (ADR-0007). -->
    <testcontainers.version>1.20.6</testcontainers.version>

    <!-- M13: the claim-check pattern's S3 client, against MinIO's S3-compatible API. AWS SDK v2
         (software.amazon.awssdk) over minio-java: (a) it is THE reference client for the S3 API
         the task brief names explicitly ("upload the document to MinIO (S3 API...)"), so the code
         exercises the actual wire protocol rather than a MinIO-specific abstraction over it;
         (b) MinIO's own docs recommend either AWS SDK or minio-java interchangeably for
         S3-compatible access - there is no MinIO-only feature this module needs (no server-side
         admin/policy calls, just PutObject/GetObject/HeadBucket/CreateBucket); (c) path-style
         addressing and a custom endpoint - both required for MinIO, since it has no per-bucket
         DNS - are first-class S3Configuration options (pathStyleAccessEnabled, endpointOverride),
         not a workaround; (d) the same client and code would work unmodified against real AWS S3
         later, which is not true of minio-java. See services/payment-api/README.md's "M13: claim
         check, measured" section. -->
    <aws-sdk.version>2.28.11</aws-sdk.version>

    <!-- Plugin versions -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <!-- M19 "Plus": maven-failsafe-plugin runs the Testcontainers integration tests (*IT.java) in
         the `integration-test`/`verify` phases. Surefire is deliberately left alone: its default
         includes are Test*.java / *Test.java / *Tests.java / *TestCase.java, none of which match
         *IT.java, so `mvn test` still runs ONLY the fast unit + ArchUnit tests and never starts a
         container. `mvn verify` runs both. -->
    <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
  </properties>

  <!-- Confluent's artifacts (kafka-avro-serializer, kafka-schema-registry-client) are not on
       Maven Central - M9 Phase 1 is the first module that needs them. -->
  <repositories>
    <repository>
      <id>confluent</id>
      <name>Confluent</name>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <modules>
    <module>libs/common-events</module>
    <module>libs/common-web</module>
    <!-- M18 phase 2: Kafka-aware HealthIndicators so a Kubernetes readiness probe reflects the
         listener containers, not just the servlet. Its own module rather than part of
         common-web - see libs/common-health/pom.xml's <description>. -->
    <module>libs/common-health</module>
    <module>services/payment-api</module>
    <module>services/psp-connector</module>
    <module>services/ledger</module>
    <module>services/webhook-notifier</module>
    <module>services/analytics</module>
    <module>services/realtime-gateway</module>
    <!-- M16 -->
    <module>services/discovery-server</module>
    <module>services/api-gateway</module>
  </modules>

  <!--
    dependencyManagement: versions live here, ONLY here. Child POMs must never
    repeat a <version> for anything declared below (ADR-0007).
  -->
  <dependencyManagement>
    <dependencies>
      <!--
        M19 "Plus": Testcontainers BOM - manages org.testcontainers:* (core, junit-jupiter, kafka,
        postgresql, mongodb) plus the Docker client stack they pull in, so a service POM only ever
        names the artifact (ADR-0007).

        Declared BEFORE spring-boot-dependencies on purpose, breaking the "framework BOM first,
        then extensions" ordering used by the Spring Cloud import below. The reason is mechanical:
        spring-boot-dependencies ALSO manages org.testcontainers:* (3.5.3 pins the 1.21.x line),
        and for <scope>import</scope> the FIRST declaration that manages a given artifact wins.
        Imported after Boot, this BOM would be silently inert and ${testcontainers.version} would
        have no effect at all. Ordering it first is what makes the pin real - verify with
        `mvn -pl services/psp-connector dependency:tree -Dincludes=org.testcontainers`.

        There is no artifact overlap between the two BOMs other than org.testcontainers itself, so
        putting this one first costs nothing else; drop this block entirely if you would rather
        track whatever Testcontainers release the Spring Boot BOM was tested against.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Spring Boot BOM - manages spring-boot-starter-*, spring-kafka, etc. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- M13: AWS SDK v2 BOM - manages software.amazon.awssdk:s3 and its transitive http-client/
           core artifacts, so payment-api and analytics only ever name the artifact (ADR-0007).
           See the aws-sdk.version property comment above for why this SDK over minio-java. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws-sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- M16: Spring Cloud BOM - manages spring-cloud-starter-gateway, spring-cloud-starter-
           netflix-eureka-{server,client}, spring-cloud-starter-circuitbreaker-reactor-resilience4j.
           Import order after spring-boot-dependencies matters little here (no overlapping
           artifacts), but this mirrors the convention of "framework BOM first, then extensions". -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>

      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok-mapstruct-binding</artifactId>
        <version>${lombok-mapstruct-binding.version}</version>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>

      <!-- M9 Phase 1: Avro + Schema Registry (payments.payment-requested.v1 only) -->
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>${avro.version}</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-avro-serializer</artifactId>
        <version>${confluent.version}</version>
      </dependency>
      <!-- M10: SpecificAvroSerde - the Kafka Streams-shaped wrapper around the same
           KafkaAvroSerializer/Deserializer pair above (a Serde is just serializer + deserializer
           in one object, which is the form every Streams API takes). Same ${confluent.version} as
           kafka-avro-serializer and as the running registry, for the reason the property's own
           comment gives. It transitively pulls org.apache.kafka:kafka-streams at Confluent's
           bundled version; the Spring Boot BOM's kafka-streams entry wins, which is what we want -
           one Kafka client version across the whole build. -->
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-streams-avro-serde</artifactId>
        <version>${confluent.version}</version>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>com.example.psp</groupId>
        <artifactId>common-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.psp</groupId>
        <artifactId>common-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.psp</groupId>
        <artifactId>common-health</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!--
              Annotation processor order is fixed HERE, once, for every module
              (ADR-0007 / PLAN.md #1 setup gotcha):

                1. Lombok                    - generates getters/setters/builders first
                2. lombok-mapstruct-binding   - bridges Lombok output to the MapStruct processor
                3. MapStruct processor        - now sees Lombok-generated accessors

              Getting this order wrong produces MapStruct mappers that silently
              ignore Lombok-generated accessors.
            -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
        </plugin>

        <!--
          M19 "Plus": Testcontainers integration tests.

          Surefire (above) and Failsafe split the suite by FILE NAME, not by annotation:

            surefire  -> **/Test*.java, **/*Test.java, **/*Tests.java, **/*TestCase.java
            failsafe  -> **/IT*.java,   **/*IT.java,   **/*ITCase.java

          The two sets are disjoint, which is the whole point: `mvn test` keeps running exactly
          what it ran before (unit tests + the per-service ArchUnit hexagon check) and never
          starts Docker, while `mvn verify` additionally runs the *IT.java classes that spin up
          real Kafka/Postgres/Mongo containers.

          `verify` is bound too, not just `integration-test`: failsafe deliberately records
          failures instead of throwing during integration-test (so post-integration-test teardown
          always runs), and it is the verify goal that turns a recorded failure into a red build.
          Binding only the first would make every IT failure silent.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <!--
              REQUIRED with spring-boot-maven-plugin:repackage. Failsafe's default
              <classesDirectory> is ${project.build.directory}/${project.build.finalName}.jar, and
              by the time integration-test runs, repackage has already replaced that jar with a
              Spring Boot fat jar whose application classes live under BOOT-INF/classes. Component
              scanning against that layout finds nothing, and every @SpringBootTest fails with
              "Unable to find a @SpringBootConfiguration by searching packages upwards from the
              test" - which looks like a package-layout bug and is not one. Pointing failsafe at
              the plain target/classes directory is the documented fix.
            -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
          <executions>
            <execution>
              <id>integration-tests</id>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Inherited by every module. Modules without an *IT.java simply have nothing to run -
           failsafe is a no-op there, so this stays a single declaration instead of being
           repeated in each service POM. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
