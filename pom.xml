<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.psp</groupId>
  <artifactId>kafka-psp-pipeline</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Kafka PSP Pipeline</name>
  <description>
    Mini PSP (payment service provider) event pipeline built to reach an intermediate Kafka
    level: Java/Spring Boot microservices, hexagonal architecture, MapStruct + Lombok,
    monorepo/Maven multi-module. See docs/PLAN.md and docs/adr/.
  </description>

  <properties>
    <!-- Language level -->
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Centralized versions (ADR-0007: child POMs declare dependencies WITHOUT versions) -->
    <spring-boot.version>3.5.3</spring-boot.version>
    <!-- M16: Spring Cloud 2025.0.x (Northfields) is the release train compatible with Spring Boot
         3.5.x (spring.io/projects/spring-cloud's compatibility matrix) - discovery-server (Eureka
         server) and api-gateway (Spring Cloud Gateway, Netflix Eureka client, LoadBalancer,
         Resilience4j Circuitbreaker) all come from this one BOM, imported below the same way the
         Spring Boot BOM already is. -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <lombok.version>1.18.38</lombok.version>
    <mapstruct.version>1.5.5.Final</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <archunit.version>1.3.0</archunit.version>
    <!-- M9 Phase 1: Avro + Schema Registry for payments.payment-requested.v1 only. avro.version
         tracks Confluent Platform 7.7.x's bundled Avro release; confluent.version is pinned to
         the SAME 7.7.1 as infra/compose/.env's SCHEMA_REGISTRY_VERSION so the client library and
         the running registry are the exact same Confluent release. -->
    <avro.version>1.11.3</avro.version>
    <confluent.version>7.7.1</confluent.version>

    <!-- Plugin versions -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
  </properties>

  <!-- Confluent's artifacts (kafka-avro-serializer, kafka-schema-registry-client) are not on
       Maven Central - M9 Phase 1 is the first module that needs them. -->
  <repositories>
    <repository>
      <id>confluent</id>
      <name>Confluent</name>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <modules>
    <module>libs/common-events</module>
    <module>libs/common-web</module>
    <!-- M18 phase 2: Kafka-aware HealthIndicators so a Kubernetes readiness probe reflects the
         listener containers, not just the servlet. Its own module rather than part of
         common-web - see libs/common-health/pom.xml's <description>. -->
    <module>libs/common-health</module>
    <module>services/payment-api</module>
    <module>services/psp-connector</module>
    <module>services/ledger</module>
    <module>services/webhook-notifier</module>
    <module>services/analytics</module>
    <module>services/realtime-gateway</module>
    <!-- M16 -->
    <module>services/discovery-server</module>
    <module>services/api-gateway</module>
  </modules>

  <!--
    dependencyManagement: versions live here, ONLY here. Child POMs must never
    repeat a <version> for anything declared below (ADR-0007).
  -->
  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM - manages spring-boot-starter-*, spring-kafka, etc. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- M16: Spring Cloud BOM - manages spring-cloud-starter-gateway, spring-cloud-starter-
           netflix-eureka-{server,client}, spring-cloud-starter-circuitbreaker-reactor-resilience4j.
           Import order after spring-boot-dependencies matters little here (no overlapping
           artifacts), but this mirrors the convention of "framework BOM first, then extensions". -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok</artifactId>
        <version>${lombok.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>

      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok-mapstruct-binding</artifactId>
        <version>${lombok-mapstruct-binding.version}</version>
      </dependency>

      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>

      <!-- M9 Phase 1: Avro + Schema Registry (payments.payment-requested.v1 only) -->
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>${avro.version}</version>
      </dependency>
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-avro-serializer</artifactId>
        <version>${confluent.version}</version>
      </dependency>
      <!-- M10: SpecificAvroSerde - the Kafka Streams-shaped wrapper around the same
           KafkaAvroSerializer/Deserializer pair above (a Serde is just serializer + deserializer
           in one object, which is the form every Streams API takes). Same ${confluent.version} as
           kafka-avro-serializer and as the running registry, for the reason the property's own
           comment gives. It transitively pulls org.apache.kafka:kafka-streams at Confluent's
           bundled version; the Spring Boot BOM's kafka-streams entry wins, which is what we want -
           one Kafka client version across the whole build. -->
      <dependency>
        <groupId>io.confluent</groupId>
        <artifactId>kafka-streams-avro-serde</artifactId>
        <version>${confluent.version}</version>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>com.example.psp</groupId>
        <artifactId>common-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.psp</groupId>
        <artifactId>common-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.psp</groupId>
        <artifactId>common-health</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!--
              Annotation processor order is fixed HERE, once, for every module
              (ADR-0007 / PLAN.md #1 setup gotcha):

                1. Lombok                    - generates getters/setters/builders first
                2. lombok-mapstruct-binding   - bridges Lombok output to the MapStruct processor
                3. MapStruct processor        - now sees Lombok-generated accessors

              Getting this order wrong produces MapStruct mappers that silently
              ignore Lombok-generated accessors.
            -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
